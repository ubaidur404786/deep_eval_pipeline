# Copy this file to .env and fill in what you have.
# Nothing in this file is needed for Phase 2 (ingestion is key-free).

# --- Application model (answers the user's question) ---
# provider: gemini | groq | ollama
APP_PROVIDER=gemini
APP_MODEL=gemini-3.1-flash-lite
# Free-tier limits measured 2026-09-12 (per model, per project):
#   gemini-3.1-flash-lite   15 RPM, ~500/day                    <- default app
#   gemini-3.5-flash-lite   15 RPM, 500/day (~2 full runs/day)  <- default judge
#   gemini-3.6-flash         5 RPM, ONLY 20 requests/day -> subsets only (--ids)
#   gemini-3.5-flash         5 RPM
#   groq / openai/gpt-oss-120b      1000 req/day, 8K tokens/min -> cross-vendor comparison app model
#   (Groq no longer serves Llama chat models on free accounts as of 2026-09-12;
#    available: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b)

# --- Judge model (scores the application's answer) ---
# Keep the judge on a DIFFERENT model than the app: separate quota bucket,
# and a model should not grade itself.
JUDGE_PROVIDER=gemini
JUDGE_MODEL=gemini-3.5-flash-lite
# fallback: JUDGE_PROVIDER=groq  JUDGE_MODEL=openai/gpt-oss-120b
#   (works, but Groq's 8K tokens/min makes a full 26-case run take ~80 min)

# --- Provider keys (only the ones you use) ---
# Google AI Studio -> https://aistudio.google.com/apikey   (free, no card)
GOOGLE_API_KEY=
# Groq             -> https://console.groq.com/keys       (free, fast)
GROQ_API_KEY=

# --- Ollama (only if JUDGE_PROVIDER=ollama or APP_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
